rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isStudent() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';
    }

    function isUniversity() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'organization';
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role in ['student', 'organization'];
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role;
      allow delete: if false;

      match /savedOpportunities/{opportunityId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
      match /deadlineReminders/{opportunityId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    match /opportunities/{opportunityId} {
      allow read: if signedIn();
      allow create: if isUniversity()
        && request.resource.data.organizationId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if (isUniversity()
        && resource.data.organizationId == request.auth.uid
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.createdBy == resource.data.createdBy)
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applicationCount']));
      allow delete: if isUniversity()
        && resource.data.organizationId == request.auth.uid;
    }

    match /applications/{applicationId} {
      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if signedIn()
        && (resource.data.studentId == request.auth.uid
          || resource.data.organizationId == request.auth.uid
          || resource.data.universityId == request.auth.uid);
      allow update: if isUniversity()
        && (resource.data.organizationId == request.auth.uid || resource.data.universityId == request.auth.uid)
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.opportunityId == resource.data.opportunityId;
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && ((request.resource.data.authorType == 'student' && isStudent())
          || (request.resource.data.authorType == 'university'
            && isUniversity()
            && request.resource.data.universityId == request.auth.uid));
      allow update: if (signedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.authorType == resource.data.authorType
        && (resource.data.authorType != 'university'
          || resource.data.universityId == request.auth.uid))
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'reportCount']));
      allow delete: if signedIn()
        && resource.data.authorId == request.auth.uid
        && (resource.data.authorType != 'university'
          || resource.data.universityId == request.auth.uid);

      match /likes/{uid} {
        allow read: if signedIn();
        allow create, delete: if signedIn() && request.auth.uid == uid;
        allow update: if false;
      }
    }

    match /comments/{commentId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId;
    }

    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.followerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }
  }
}
